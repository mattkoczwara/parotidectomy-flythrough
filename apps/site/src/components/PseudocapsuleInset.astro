---
/**
 * Magnified schematic of a pleomorphic adenoma's edge (plan §3 chapter 4): the capsule that is often thin or
 * incomplete, a pseudopodium, satellite nodules, and the two ways of cutting. Line grammar: a simplification, drawn
 * to show the features, not a section of a real tumour (claim pa-capsule-features). `mode` chooses the cut shown.
 */
interface Props {
  mode?: 'features' | 'cuts';
}
const { mode = 'features' } = Astro.props;
const blob = 'M 100 95 C 105 65, 145 50, 175 62 C 205 70, 218 100, 210 125 C 202 150, 170 168, 140 162 C 110 156, 92 125, 100 95 Z';
---

<svg viewBox="0 0 330 222" role="img" aria-label={mode === 'features' ? 'Schematic of a tumour edge: a thin, incomplete capsule, a finger-like pseudopodium and small satellite nodules in the surrounding gland.' : 'Schematic: cutting along the capsule leaves the pseudopodium and satellite nodules behind; cutting through a rim of normal gland removes them.'}>
  <defs>
    <pattern id="gland-hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(35)">
      <line x1="0" y1="0" x2="0" y2="7" stroke="rgba(236,230,220,0.2)" stroke-width="1"></line>
    </pattern>
  </defs>
  <rect x="6" y="6" width="318" height="210" rx="6" fill="url(#gland-hatch)" stroke="rgba(236,230,220,0.25)" stroke-width="1"></rect>
  <text x="14" y="20" class="soft">normal gland</text>

  <!-- the capsule: a thin line that stops and starts -->
  <path d={blob} transform="translate(-6 -4.4) scale(1.04)" class="hair" stroke-dasharray="92 10 60 14 80 9 40 12 70 8" stroke-width="1.3"></path>
  <!-- the tumour -->
  <path d={blob} class="fill"></path>
  <!-- a finger-like pseudopodium and a place where tumour breaches the capsule -->
  <path d="M 208 112 C 224 106 242 112 256 126 C 246 134 228 134 211 127 Z" class="fill"></path>
  <path d="M 114 70 C 102 60 94 48 95 38 C 105 42 116 52 124 63 Z" class="fill"></path>
  <!-- satellite nodules in the gland beyond -->
  <circle cx="276" cy="92" r="7" class="fill"></circle>
  <circle cx="72" cy="148" r="6" class="fill"></circle>
  <circle cx="236" cy="42" r="4.5" class="fill"></circle>

  {mode === 'cuts' && (
    <>
      <path d={blob} transform="translate(-6 -4.4) scale(1.04)" class="dash"></path>
      <path d={blob} transform="translate(-75 -55) scale(1.5)" class="ink" stroke-width="2"></path>
    </>
  )}

  {mode === 'features' ? (
    <>
      <text x="152" y="112" text-anchor="middle">tumour</text>
      <line x1="246" y1="38" x2="214" y2="66" class="hair"></line><text x="250" y="36" class="soft">capsule: thin or</text><text x="250" y="47" class="soft">incomplete in places</text>
      <line x1="264" y1="150" x2="248" y2="130" class="hair"></line><text x="212" y="166" class="soft">pseudopodium</text>
      <line x1="288" y1="108" x2="280" y2="98" class="hair"></line><text x="262" y="122" class="soft">satellite</text><text x="262" y="133" class="soft">nodule</text>
    </>
  ) : (
    <>
      <text x="152" y="112" text-anchor="middle">tumour</text>
      <text x="16" y="206" class="soft">dashed: shelling out along the capsule leaves the finger and the nodules</text>
      <text x="16" y="194" class="soft">violet line: a rim of normal gland taken with the tumour includes them</text>
    </>
  )}
</svg>

---
/**
 * One institution's postoperative routine as a timeline (plan §3 chapter 9). Marked as institutional practice: the
 * evidence for healing timelines is weak, so every entry is a representative-technique claim from one protocol.
 */
import Claim from './Claim.astro';
---

<ol class="timeline">
  <li><span class="when">Day 0, once awake</span><span class="what"><Claim id="postop-timeline">The dressing comes off; the wound is looked at.</Claim></span></li>
  <li><span class="when">From 36 hours</span><span class="what"><Claim id="drain-technique">The suction drain stays at least this long, and comes out when its output is low.</Claim></span></li>
  <li><span class="when">Day 1</span><span class="what"><Claim id="postop-timeline">Home with the drain, once the patient can manage it.</Claim></span></li>
  <li><span class="when">Day 6</span><span class="what"><Claim id="postop-timeline">Back for removal of the stitches and the drain.</Claim></span></li>
</ol>

---
/**
 * A margin note (plan §3): collapsed at Essentials, available at Anatomy and open at Clinical depth. Nothing is
 * hidden: any note can be opened at any depth. The director sets `open` from the reading depth.
 */
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<details class="note" data-note>
  <summary>{title}</summary>
  <div class="note-body"><slot /></div>
</details>

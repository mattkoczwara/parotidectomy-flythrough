{
  "name": "@atlas/capture",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Playwright harness against the production build: static fallback figures, plate determinism, and accessibility behaviour (focus, announcements).",
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "capture": "playwright test",
    "perf": "playwright test -c playwright.perf.config.ts",
    "figures": "playwright test -g \"static fallback figure\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5"
  }
}
